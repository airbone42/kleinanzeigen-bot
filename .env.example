# Telegram
TELEGRAM_BOT_TOKEN=dein-telegram-bot-token
# Comma-separated list of allowed Telegram user IDs
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# OpenRouter
OPENROUTER_API_KEY=dein-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kleinanzeigen
# Path to kleinanzeigen-bot configuration directory
KLEINANZEIGEN_CONFIG_PATH=./kleinanzeigen-config
# Chromium binary for kleinanzeigen-bot (empty: search PATH)
CHROMIUM_PATH=

# Discogs
DISCOGS_USER_TOKEN=dein-discogs-user-token
DISCOGS_USERNAME=dein-discogs-username

# Vinted mirror (docs/vinted.md). Off by default: Vinted's terms forbid bots,
# accounts can be banned. The session is imported once via /vintedlogin.
VINTED_ENABLED=false
VINTED_BASE_URL=https://www.vinted.de
VINTED_LOCALE=de-DE
VINTED_CURRENCY=EUR
# Vinted price = Kleinanzeigen price x factor (rounded, min 1 EUR)
VINTED_PRICE_FACTOR=1.0
# Sync runs (hour, Europe/Berlin, at :30): sold on Vinted -> delete on Kleinanzeigen and vice versa
VINTED_SYNC_HOURS=8,12,16,20
# Older Kleinanzeigen listings mirrored per sync run (0 = only new listings)
VINTED_BACKFILL_PER_RUN=2
# Runs a listing must be missing on Kleinanzeigen before its Vinted twin is deleted
VINTED_MISSING_RUNS_BEFORE_DELETE=2

# Scheduler (daily check time)
DAILY_CHECK_HOUR=6
DAILY_CHECK_MINUTE=0

# Renewal thresholds (listings with days_remaining below this are "expiring soon").
# PICKUP-only listings are renewed twice as often as shipping listings.
SHIPPING_EXPIRING_DAYS=10
PICKUP_EXPIRING_DAYS=30

# LangSmith Observability (optional – https://smith.langchain.com)
# Enables node-by-node trace visualization for LangGraph workflows
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=dein-langsmith-api-key
LANGCHAIN_PROJECT=kleinanzeigen-bot

# General
LOG_LEVEL=INFO
DATABASE_PATH=./data/bot.db
