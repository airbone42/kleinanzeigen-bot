# Telegram
TELEGRAM_BOT_TOKEN=dein-telegram-bot-token
# Comma-separated list of allowed Telegram user IDs
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# OpenRouter
OPENROUTER_API_KEY=dein-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kleinanzeigen
# Path to kleinanzeigen-bot configuration directory
KLEINANZEIGEN_CONFIG_PATH=./kleinanzeigen-config

# Discogs
DISCOGS_USER_TOKEN=dein-discogs-user-token
DISCOGS_USERNAME=dein-discogs-username

# Scheduler (daily check time)
DAILY_CHECK_HOUR=6
DAILY_CHECK_MINUTE=0

# Renewal thresholds (listings with days_remaining below this are "expiring soon").
# PICKUP-only listings are renewed twice as often as shipping listings.
SHIPPING_EXPIRING_DAYS=10
PICKUP_EXPIRING_DAYS=30

# LangSmith Observability (optional – https://smith.langchain.com)
# Enables node-by-node trace visualization for LangGraph workflows
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=dein-langsmith-api-key
LANGCHAIN_PROJECT=kleinanzeigen-bot

# General
LOG_LEVEL=INFO
DATABASE_PATH=./data/bot.db
